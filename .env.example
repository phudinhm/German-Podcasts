# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. The app runs fully with none of these set:
# the catalog is bundled JSON, the dictionary falls back to a local lexicon,
# and the vocabulary vault persists in the browser.
# ---------------------------------------------------------------------------

# Anthropic - powers the Grammar Deconstructor, quiz generation and the
# dictionary fallback for words missing from the bundled lexicon.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepL - preferred machine translation for sentence-level output.
# Free tier host is api-free.deepl.com, Pro is api.deepl.com
DEEPL_API_KEY=
DEEPL_API_HOST=api-free.deepl.com

# Google Cloud Translation v2 - alternative to DeepL.
GOOGLE_TRANSLATE_API_KEY=

# Supabase - optional server-side catalog + cross-device vault sync.
# Without these the app reads data/catalog/*.json and localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API - optional. Without it, YouTube channel and playlist links
# still work (their Atom feeds need no key); only keyword search across YouTube
# is unavailable, and Apple Podcasts carries the search on its own.
YOUTUBE_API_KEY=

# Spotify - optional. Without these, a Spotify show link is still resolved by
# reading the public page's Open Graph tags. Spotify never permits third-party
# streaming of its audio either way; the app bridges to the show's public RSS.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Azure Speech - optional pronunciation assessment.
# Without it the app falls back to on-device Web Speech scoring.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
