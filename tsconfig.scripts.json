{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".scripts-out",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "files": [
    "lib/types.ts",
    "lib/server/feed.ts",
    "lib/media.ts",
    "lib/server/discover.ts",
    "lib/server/range.ts",
    "lib/library.ts"
  ]
}
